REACT_APP_SANITY_PROJECT_ID=fqck037q
REACT_APP_SANITY_DATASET=production
REACT_APP_SANITY_API_VERSION=2025-01-01

# Analytics (optionnel)
REACT_APP_PLAUSIBLE_DOMAIN=
REACT_APP_GA_MEASUREMENT_ID=

# Formulaire gratuit Web3Forms — https://web3forms.com
# 1. Va sur le site, entre ton email, récupère ta "Access Key"
# 2. Colle-la ci-dessous puis redémarre npm start
# 3. Anti-spam : dans https://app.web3forms.com → ton formulaire → Settings
#    active "hCaptcha" comme Block Spam (obligatoire pour bloquer les bots)
# Le formulaire apparaît automatiquement dans la section Contact
REACT_APP_WEB3FORMS_ACCESS_KEY=
